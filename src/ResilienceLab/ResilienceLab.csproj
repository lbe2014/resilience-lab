<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0</Version>
    <Authors>ResilienceLab contributors</Authors>
    <Description>Educational .NET resilience: result and exception retry, fallback, rate limiting, hedging, timeout and circuit breaker.</Description>
    <PackageTags>resilience;retry;timeout;circuit-breaker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../OBSERVABILITY.md" Pack="true" PackagePath="/" />
    <None Include="../../STRATEGIES.md" Pack="true" PackagePath="/" />
    <None Include="../../PIPELINES.md" Pack="true" PackagePath="/" />
    <None Include="../../TRACING.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
