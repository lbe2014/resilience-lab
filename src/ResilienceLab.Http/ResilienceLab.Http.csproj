<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0</Version>
    <Authors>ResilienceLab contributors</Authors>
    <Description>Reintentos HTTP con backoff, jitter, Retry-After, cancelación y registro tipado de IHttpClientFactory.</Description>
    <PackageTags>resilience;http;retry;dotnet</PackageTags>
